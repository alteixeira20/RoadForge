POSTGRES_PASSWORD=change-me-generate-a-long-random-password

ROADFORGE_ENVIRONMENT=production
# Required: set this to the central nginx container IP or the narrowest Docker
# edge-network CIDR that may supply forwarded client IP headers. Never use
# 0.0.0.0/0 or ::/0.
ROADFORGE_TRUSTED_PROXY_IPS=replace-with-nginx-ip-or-edge-network-cidr

NEXT_PUBLIC_API_URL=https://roadforge.anvilary.tools
ROADFORGE_WEB_BASE_URL=https://roadforge.anvilary.tools
ROADFORGE_CORS_ORIGINS=https://roadforge.anvilary.tools

# Frontend document CSP. Production defaults to enforce. Use report-only for a
# bounded observation/rollback window, then return to enforce on the same build.
ROADFORGE_CSP_MODE=enforce

# Redis is provisioned for realtime coordination. Keep memory active unless
# explicitly validating Redis-backed realtime or approved multi-worker mode.
REDIS_URL=redis://roadforge-redis:6379/0
ROADFORGE_REALTIME_BACKEND=memory
ROADFORGE_REDIS_KEY_PREFIX=roadforge:prod

# Keep production single-worker by default. Values greater than 1 require
# ROADFORGE_REALTIME_BACKEND=redis and completed RF-886 manual validation.
ROADFORGE_API_WORKERS=1
