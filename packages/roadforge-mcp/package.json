{
  "name": "@anvilary/roadforge-mcp",
  "version": "0.1.0-alpha.0",
  "description": "Token-efficient MCP server for RoadForge roadmaps.",
  "type": "module",
  "private": false,
  "bin": {
    "roadforge-mcp": "./bin/roadforge-mcp.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
