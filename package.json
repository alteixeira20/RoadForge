{
  "name": "@anvilary/roadforge",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "check:copy": "node tools/check-product-copy.mjs && node tools/check-release-contract.mjs && node tools/check-no-em-dash.mjs",
    "check:cycles": "node tools/check-web-import-cycles.mjs",
    "check:docs": "node tools/check-doc-links.mjs",
    "check:issues": "node tools/check-issue-forms.mjs",
    "check:release": "node tools/check-release-contract.mjs",
    "lint": "pnpm --dir apps/web lint",
    "typecheck": "pnpm --dir apps/web typecheck",
    "test": "pnpm --dir apps/web test",
    "test:web": "pnpm --dir apps/web test",
    "check:em-dash": "node tools/check-no-em-dash.mjs"
  },
  "version": "0.1.0",
  "description": "Local-first, accountless roadmap planning for individuals and small teams.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://roadforge.anvilary.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alteixeira20/RoadForge.git"
  },
  "bugs": {
    "url": "https://github.com/alteixeira20/RoadForge/issues"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "comments": {
      "overrides": "Next pins vulnerable transitive versions; these raise them to patched ranges reported by `make audit`. Drop an entry once Next ships the patched dependency."
    },
    "overrides": {
      "nanoid@<3.3.17": "^3.3.17",
      "postcss": "^8.5.26",
      "sharp": "^0.35.4"
    }
  }
}
